---
import type { Situacao } from '../content/obras';

interface Props {
  situacao?: Situacao;
  destaque?: boolean;
}
const { situacao, destaque = false } = Astro.props;

/*
 * Disponível = verde-oliva, Vendida = rosé seco, texto branco.
 * Além da cor, as duas diferem na forma do marcador (ponto cheio × anel)
 * e no rótulo escrito — quem não distingue as cores continua lendo.
 */
const rotulo = situacao === 'disponivel' ? 'Disponível' : 'Vendida';
---

{situacao && <span class:list={['selo', situacao, { destaque }]}><span class="ponto" aria-hidden="true"></span>{rotulo}</span>}

<style>
  .selo {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 6px;
    flex-shrink: 0;
    padding: 4px 10px 4px 9px;
    border-radius: var(--raio);
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--branco);
    white-space: nowrap;
  }

  .ponto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .disponivel {
    background: var(--disponivel);
  }

  .disponivel .ponto {
    background: var(--branco);
  }

  .vendida {
    background: var(--vendida);
  }

  .vendida .ponto {
    border: 1.5px solid var(--branco);
  }

  .destaque {
    gap: 10px;
    padding: 10px 18px 10px 16px;
    font-size: 14px;
  }

  .destaque .ponto {
    width: 9px;
    height: 9px;
  }
</style>
