---
import { SITE, type Pagina } from '../config/site';
import { linkWhatsApp } from '../config/contato';
import { videos } from '../content/videos';

interface Props {
  atual?: Pagina;
}
const { atual } = Astro.props;

/** Só entram rotas que existem. Item de menu que cai em 404 é pior que item ausente. */
const menu: { rotulo: string; href: string; chave: Pagina }[] = [
  { rotulo: 'O atelier', href: '/o-atelier', chave: 'atelier' },
  { rotulo: 'Aulas', href: '/aulas', chave: 'aulas' },
  { rotulo: 'Oficinas', href: '/oficinas', chave: 'oficinas' },
  { rotulo: 'Aulas online', href: '/online', chave: 'online' },
  { rotulo: 'Professores', href: '/professores', chave: 'professores' },
  { rotulo: 'Obras', href: '/obras', chave: 'obras' },
  ...(videos.length > 0 ? [{ rotulo: 'Vídeos', href: '/videos', chave: 'videos' as Pagina }] : []),
];
const whatsapp = linkWhatsApp();
---

<header class="cabecalho">
  <div class="conteiner linha">
    <a class="marca" href="/" aria-current={atual === 'inicio' ? 'page' : undefined}>
      <span class="ponto" aria-hidden="true"></span>{SITE.nome}
    </a>

    <nav class="nav-larga" aria-label="Principal">
      <ul>
        {
          menu.map((item) => (
            <li>
              <a href={item.href} aria-current={atual === item.chave ? 'page' : undefined}>
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="botao botao--pequeno" href={whatsapp} target="_blank" rel="noopener">Falar com o atelier</a>
    </nav>

    <!-- No celular: menu num <details>, sem JavaScript. -->
    <details class="nav-celular">
      <summary>
        <svg aria-hidden="true" width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 1h16M1 7h16M1 13h16"></path></svg>
        Menu
      </summary>
      <nav aria-label="Principal no celular">
        <ul>
          {
            menu.map((item) => (
              <li>
                <a href={item.href} aria-current={atual === item.chave ? 'page' : undefined}>
                  {item.rotulo}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="botao" href={whatsapp} target="_blank" rel="noopener">Falar com o atelier</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .cabecalho {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--linha);
  }

  .linha {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-family: var(--marca);
    font-size: 27px;
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--texto);
    text-decoration: none;
  }

  .ponto {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--oliva);
  }

  .nav-larga {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  ul {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-larga ul a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-bottom: 2px solid transparent;
    color: var(--texto);
    font-size: 16px;
    text-decoration: none;
    transition: color var(--duracao) var(--entrada), border-color var(--duracao) var(--entrada);
  }

  .nav-larga ul a:hover {
    color: var(--oliva);
  }

  .nav-larga ul a[aria-current='page'] {
    color: var(--oliva);
    font-weight: 600;
    border-bottom-color: var(--oliva);
  }

  .nav-celular {
    display: none;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: var(--raio);
    background: var(--secao);
    color: var(--texto);
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .nav-celular nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px var(--margem) 24px;
    background: var(--fundo);
    border-bottom: 1px solid var(--linha);
    box-shadow: var(--sombra-menu);
  }

  .nav-celular ul {
    flex-direction: column;
    gap: 0;
  }

  .nav-celular ul a {
    display: flex;
    align-items: center;
    min-height: 52px;
    border-bottom: 1px solid var(--linha);
    color: var(--texto);
    font-size: 18px;
    text-decoration: none;
  }

  .nav-celular ul a[aria-current='page'] {
    color: var(--oliva);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .linha {
      min-height: 68px;
    }

    .marca {
      font-size: 23px;
    }

    .nav-larga {
      display: none;
    }

    .nav-celular {
      display: block;
    }
  }
</style>
