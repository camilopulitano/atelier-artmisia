---
import { linkAulaExperimental, linkAulaExperimentalTurma, linkTurma } from '../config/contato';
import { SITUACOES_TURMA, turmasDe, type Curso } from '../content/cursos';
import type { Professor } from '../content/professores';
import { TEXTOS } from '../content/textos';

/**
 * Turmas de um curso.
 * - Duração/frequência e valor (`ritmo`, `valor` em cursos.ts), quando o curso tem.
 * - Horários (`turmas` em cursos.ts), quando o curso tem: lista de dia + horário.
 * - Sempre os botões do WhatsApp, com o nome do curso e do professor na mensagem.
 */
interface Props {
  curso: Curso;
  professor: Professor;
  /** Mantido por compatibilidade com a página do professor. */
  comCurso?: boolean;
}
const { curso, professor } = Astro.props;
const turmas = turmasDe(curso);
const whatsapp = linkTurma(curso, professor);
---

{
  (curso.ritmo || curso.valor || turmas.length > 0) && (
    <div class="turmas">
      {(curso.ritmo || curso.valor) && (
        <dl class="info">
          {curso.ritmo && (
            <div><dt>Aulas</dt><dd>{curso.ritmo}</dd></div>
          )}
          {curso.valor && (
            <div>
              <dt>Valor</dt>
              <dd>{curso.valor}{TEXTOS.aulas.material && <span class="material">{TEXTOS.aulas.material}</span>}</dd>
            </div>
          )}
        </dl>
      )}
      {turmas.length > 0 && (
        <div>
          <p class="rotulo" id={`horarios-${curso.slug}`}>Horários · clique para marcar uma aula experimental</p>
          <ul class="horarios" aria-labelledby={`horarios-${curso.slug}`}>
            {turmas.map((t) => (
              <li>
                <a href={linkAulaExperimentalTurma(curso, t)} target="_blank" rel="noopener">
                  <span class="dia">{t.dia}</span>
                  <span class="hora">{t.horario}</span>
                  {t.situacao && <span class:list={['situacao', t.situacao]}>{SITUACOES_TURMA[t.situacao]}</span>}
                  <span class="so-leitor"> — marcar aula experimental de {curso.nome} no WhatsApp (abre em nova aba)</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )
}
<div class="consulta">
  <a class="botao" href={whatsapp} target="_blank" rel="noopener">
    {turmas.length > 0 ? 'Consultar vagas disponíveis' : TEXTOS.botaoTurmas}
    <span class="so-leitor"> — {curso.nome} no WhatsApp (abre em nova aba)</span>
  </a>
  <a class="botao botao--contorno" href={linkAulaExperimental(curso)} target="_blank" rel="noopener">
    {TEXTOS.botaoExperimental}
    <span class="so-leitor"> — {curso.nome} (abre em nova aba)</span>
  </a>
</div>

<style>
  .consulta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 4px;
  }

  @media (max-width: 520px) {
    .consulta .botao {
      width: 100%;
    }
  }

  .turmas {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px 18px;
    border-radius: var(--raio);
    background: var(--fundo);
  }

  .info {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 0;
  }

  .info dd {
    margin: 2px 0 0;
    font-size: 17px;
    font-weight: 600;
  }

  .material {
    display: block;
    margin-top: 2px;
    font-size: 14px;
    font-weight: 400;
    color: var(--texto-suave);
  }

  dt,
  .rotulo {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .horarios {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
    gap: 8px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .horarios li {
    display: flex;
  }

  .horarios a {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    background: var(--cartao);
    color: var(--texto);
    text-decoration: none;
  }

  .horarios a:hover,
  .horarios a:focus-visible {
    border-color: var(--oliva);
  }

  .horarios a:hover .hora,
  .horarios a:focus-visible .hora {
    color: var(--oliva);
  }

  .dia {
    font-size: 15px;
    color: var(--texto-suave);
  }

  .hora {
    font-size: 17px;
    font-weight: 600;
  }

  .situacao {
    align-self: flex-start;
    margin-top: 4px;
    padding: 2px 10px;
    border-radius: var(--raio);
    font-size: 14px;
    font-weight: 600;
  }

  .situacao.vagas {
    background: var(--oliva);
    color: var(--branco);
  }

  .situacao.espera {
    border: 1.5px solid var(--texto-suave);
    color: var(--texto);
  }
</style>
