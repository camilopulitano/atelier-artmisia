---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Depoimento } from '../content/online';

interface Props {
  titulo: string;
  itens: Depoimento[];
  id: string;
}
const { titulo, itens, id } = Astro.props;
---

{
  itens.length > 0 && (
    <section class="depoimentos" aria-labelledby={id}>
      <h3 id={id}>{titulo}</h3>
      <div class="carrossel" role="region" aria-roledescription="carrossel" aria-label={titulo}>
        <ul class="lista-depoimentos" role="list">
          {itens.map((d) => {
            const nome = d.nome ?? 'Aluna do curso online da Ana';
            return (
              <li class="depoimento">
                {d.foto && (
                  <div class="fotos-dep">
                    {[[d.foto, d.fotoAlt], [d.foto2, d.foto2Alt], [d.foto3, d.foto3Alt]].map(([src, alt]) =>
                      src ? <Image src={src as ImageMetadata} alt={(alt as string) ?? ''} widths={[320, 480, 640]} sizes="(max-width: 700px) 90vw, 300px" quality={76} format="webp" loading="lazy" /> : null,
                    )}
                    <div class="legenda-linha">
                      {itens.length > 1 && <button type="button" class="seta" data-anterior aria-label="Depoimento anterior">←</button>}
                      <p class="legenda">{nome}</p>
                      {itens.length > 1 && <button type="button" class="seta" data-proximo aria-label="Próximo depoimento">→</button>}
                    </div>
                  </div>
                )}
                <figure>
                  <blockquote>{d.texto.split('\n\n').map((par) => <p>{par}</p>)}</blockquote>
                  {!d.foto && <figcaption class="legenda">{nome}</figcaption>}
                </figure>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<script>
  // Um depoimento por vez: o bloco tem a altura do depoimento que está aparecendo.
  document.querySelectorAll<HTMLElement>('.carrossel').forEach((c) => {
    const slides = Array.from(c.querySelectorAll<HTMLElement>('.depoimento'));
    if (slides.length < 2) return;
    let atual = 0;
    const mostrar = (i: number) => {
      atual = (i + slides.length) % slides.length;
      slides.forEach((sl, n) => (sl.hidden = n !== atual));
    };
    mostrar(0);
    c.addEventListener('click', (e) => {
      const botao = (e.target as HTMLElement).closest('[data-anterior], [data-proximo]');
      if (!botao) return;
      mostrar(atual + (botao.hasAttribute('data-proximo') ? 1 : -1));
      c.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  });
</script>

<style>
  .depoimentos {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 8px;
    margin-bottom: 20px;
    padding: clamp(16px, 2.5vw, 24px);
    border-radius: var(--raio);
    background: var(--secao);
  }

  .lista-depoimentos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .depoimento[hidden] {
    display: none;
  }

  .legenda-linha {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 2px;
  }

  .seta {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border: 1px solid var(--texto-suave);
    border-radius: 50%;
    background: transparent;
    color: var(--texto);
    font-size: 20px;
    cursor: pointer;
  }

  .seta:hover {
    background: var(--secao);
  }

  .depoimento {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fotos-dep {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 10px;
    max-width: 100%;
  }

  .depoimento :global(img) {
    flex: 0 1 260px;
    width: 260px;
    max-width: 100%;
    height: auto;
    border-radius: var(--raio);
  }

  .legenda-linha {
    flex: 1 1 100%;
    max-width: 560px;
  }

  .depoimento figure {
    min-width: 0;
    max-width: 44em;
    margin: 0;
  }

  .depoimento blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(18px, 1.8vw, 21px);
    line-height: 1.6;
  }

  .depoimento blockquote p + p {
    margin-top: 0.8em;
  }

  .legenda {
    margin: 0;
    flex: 1 1 auto;
    text-align: center;
    font-size: 15px;
    font-weight: 600;
    color: var(--oliva);
  }


  h3 {
    font-size: 20px;
    font-weight: 500;
  }
</style>
