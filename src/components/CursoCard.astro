---
import { Image } from 'astro:assets';
import { idadeRotulo, professorDe, type Curso } from '../content/cursos';

/**
 * Cartão de curso da home, no modelo pedido pela Ana (referência: Escola Panorama):
 * capa grande em cima, nome, idade e professor, e um botão "Saiba mais".
 */
interface Props {
  curso: Curso;
}
const { curso } = Astro.props;
const professor = professorDe(curso);
---

<article class="curso">
  <a class="capa" href={`/aulas#${curso.slug}`} tabindex="-1" aria-hidden="true">
    <Image
      src={curso.capa}
      alt=""
      widths={[360, 540, 720, 900]}
      sizes="(max-width: 560px) 92vw, (max-width: 1000px) 46vw, 380px"
      quality={76}
      format="webp"
      loading="lazy"
      data-fade=""
    />
  </a>
  <h3>{curso.nome}</h3>
  <p class="idade">{idadeRotulo(curso)}</p>
  <p class="texto-suave">com {professor.nome}</p>
  <a class="botao botao--pequeno" href={`/aulas#${curso.slug}`}>Saiba mais<span class="so-leitor"> sobre {curso.nome}</span></a>
</article>

<style>
  .curso {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .capa {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    margin-bottom: 14px;
    overflow: hidden;
    border-radius: var(--raio-cartao);
    background: var(--cartao);
  }

  .capa :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--entrada);
  }

  .capa:hover :global(img) {
    transform: scale(1.03);
  }

  h3 {
    font-size: clamp(22px, 2.2vw, 26px);
    font-weight: 500;
  }

  .idade {
    font-size: 15px;
    font-weight: 600;
    color: var(--oliva);
  }

  .texto-suave {
    font-size: 15px;
  }

  .botao {
    margin-top: 10px;
  }

  @media (prefers-reduced-motion: reduce) {
    .capa :global(img) {
      transition: none;
    }
  }
</style>
