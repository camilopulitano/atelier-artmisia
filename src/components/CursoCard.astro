---
import { Image } from 'astro:assets';
import { idadeRotulo, professorDe, type Curso } from '../content/cursos';

/**
 * Cartão de curso da home: imagem inteira (nunca cortada), nome, idade,
 * professor, uma frase do curso e o link para o curso na página de aulas.
 */
interface Props {
  curso: Curso;
}
const { curso } = Astro.props;
const professor = professorDe(curso);
---

<article class="cartao curso">
  <div class="capa">
    <Image
      src={curso.capa}
      alt={curso.capaAlt}
      widths={[180, 300, 420]}
      sizes="150px"
      quality={74}
      format="webp"
      loading="lazy"
      data-fade=""
    />
  </div>
  <div class="texto">
    <h3>{curso.nome}</h3>
    <p class="idade">{idadeRotulo(curso)}</p>
    <p class="texto-suave">com {professor.nome}</p>
    <p class="resumo">{curso.resumo}</p>
    <a class="link-seta" href={`/aulas#${curso.slug}`}>Ver o curso <span aria-hidden="true">→</span><span class="so-leitor"> {curso.nome}</span></a>
  </div>
</article>

<style>
  .curso {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    padding: 22px;
  }

  .capa {
    flex: 0 0 150px;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    border-radius: 4px;
    background: var(--fundo);
  }

  .capa :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .texto {
    flex: 1 1 220px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h3 {
    font-size: 25px;
    font-weight: 500;
  }

  .texto > p {
    font-size: 16px;
  }

  .idade {
    font-size: 15px !important;
    font-weight: 600;
    color: var(--oliva);
  }

  .link-seta {
    margin-top: auto;
    font-size: 15px;
  }

  @media (max-width: 520px) {
    .curso {
      flex-wrap: nowrap;
      gap: 14px;
      padding: 12px;
    }

    .capa {
      flex-basis: 76px;
      height: 92px;
      padding: 5px;
    }

    h3 {
      font-size: 21px;
    }

    .resumo {
      display: none;
    }
  }
</style>
