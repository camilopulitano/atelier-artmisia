---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Destaque from '../components/Destaque.astro';
import Preencher from '../components/Preencher.astro';
import TurmasTabela from '../components/TurmasTabela.astro';
import Oficinas from '../components/Oficinas.astro';
import { cursos, fotosDe, idadeRotulo, professorDe, PUBLICOS, SITUACOES_TURMA, turmas, type Publico } from '../content/cursos';
import { retratoDe, professores } from '../content/professores';
import { cursosOnline, FORMATOS_ONLINE } from '../content/online';
import { TEXTOS, semMarcas } from '../content/textos';
import { linkAulaExperimental, linkConsultaTurmas } from '../config/contato';

const publicos = Object.entries(PUBLICOS) as [Publico, string][];
const temSituacao = turmas.some((t) => t.situacao);
---

<BaseLayout
  titulo={semMarcas(TEXTOS.aulas.titulo)}
  descricao={TEXTOS.aulas.intro}
  paginaAtual="aulas"
>
  <section class="conteiner topo" aria-labelledby="titulo-aulas">
    <nav class="trilha" aria-label="Você está aqui"><a href="/">Início</a> / <span aria-current="page">Aulas</span></nav>
    <h1 id="titulo-aulas" class="titulo-pagina"><Destaque texto={TEXTOS.aulas.titulo} /></h1>
    <p class="intro texto-suave">{TEXTOS.aulas.intro}</p>
    <p class="texto-suave online">Mora longe ou prefere aprender de casa? Veja as <a href="#aulas-online">aulas online</a>, logo abaixo dos cursos presenciais.</p>
    <div class="filtros" role="group" aria-label="Filtrar por público">
      <button type="button" class="pilula" data-publico="todos" aria-pressed="true">Todas</button>
      {publicos.map(([valor, rotulo]) => (
        <button type="button" class="pilula" data-publico={valor} aria-pressed="false">{rotulo}</button>
      ))}
    </div>
    <p class="so-leitor" id="resumo" aria-live="polite"></p>
  </section>

  <section class="faixa-secao" aria-label="Cursos e turmas">
    <div class="conteiner lista">
      {
        cursos.map((curso) => {
          const professor = professorDe(curso);
          return (
            <article
              id={curso.slug}
              class="cartao curso"
              data-publico={curso.publico.join(' ')}
              aria-labelledby={`titulo-${curso.slug}`}
            >
              <a class="quem" href={`/professores/${professor.slug}`}>
                <Image
                  src={retratoDe(professor)}
                  alt={professor.retratoAlt}
                  widths={[120, 240]}
                  sizes="120px"
                  quality={74}
                  format="webp"
                  loading="lazy"
                  data-fade=""
                  style={`object-position: ${professor.foco}`}
                />
                <span>{professor.nome}</span>
              </a>
              <div class="dados">
                <h2 id={`titulo-${curso.slug}`}>{curso.nome}</h2>
                <p class="idade">{idadeRotulo(curso)}</p>
                <div class="descricao texto-suave">
                  {curso.descricao.map((paragrafo) => <p>{paragrafo}</p>)}
                </div>
                <TurmasTabela curso={curso} professor={professor} />
              </div>
              {fotosDe(curso).length > 0 && (
                <ul class="fotos" aria-label={`Fotos da aula de ${curso.nome}`}>
                  {fotosDe(curso).map((f) => (
                    <li>
                      <Image
                        src={f.src}
                        alt={f.alt}
                        widths={[280, 420, 640]}
                        sizes="(max-width: 700px) 70vw, 240px"
                        quality={74}
                        format="webp"
                        loading="lazy"
                        data-fade=""
                      />
                    </li>
                  ))}
                </ul>
              )}
            </article>
          );
        })
      }
      <p class="vazio" id="vazio" hidden>Ainda não há turma cadastrada para esse público. Fale com o atelier.</p>
      {
        temSituacao && (
          <div class="legenda texto-suave">
            <span>Como a situação da turma aparece:</span>
            <span class="situacao vagas">{SITUACOES_TURMA.vagas}</span>
            <span class="situacao espera">{SITUACOES_TURMA.espera}</span>
          </div>
        )
      }
    </div>
  </section>

  <section class="faixa-secao" id="aulas-online" aria-labelledby="titulo-online-aulas">
    <div class="conteiner lista">
      <div class="cab-online">
        <h2 id="titulo-online-aulas" class="titulo-secao">Aulas <em>online</em></h2>
        <p class="texto-suave">Aprenda de onde estiver, com os professores do atelier.</p>
      </div>
      {
        cursosOnline.map((c) => {
          const professor = professores.find((p) => p.slug === c.professor)!;
          return (
            <article class="cartao curso-online" aria-labelledby={`aula-online-${c.slug}`}>
              <a class="quem" href={`/professores/${professor.slug}`}>
                <Image src={retratoDe(professor)} alt={professor.retratoAlt} widths={[120, 240]} sizes="120px" quality={74} format="webp" loading="lazy" style={`object-position: ${professor.foco}`} />
                <span>{professor.nome}</span>
              </a>
              <div class="dados">
                <h3 id={`aula-online-${c.slug}`}>{c.nome}</h3>
                <p class="idade">{c.rotulo ?? FORMATOS_ONLINE[c.formato]}{c.publico ? ` · ${c.publico}` : ''}</p>
                {c.descricao && <p class="texto-suave">{c.descricao.split('\n\n')[0]}</p>}
                {(c.valor || c.dia) && (
                  <p><strong>{[c.dia && `${c.dia}${c.horario ? `, ${c.horario}` : ''}`, c.valor].filter(Boolean).join(' · ')}</strong></p>
                )}
                <a class="link-seta" href={`/online#${c.slug}`}>Ver detalhes, fotos e depoimentos <span aria-hidden="true">→</span></a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <Oficinas comFormulario={false} />

  <section class="faixa-secao" aria-labelledby="titulo-chamada">
  <div class="conteiner chamada">
    <div class="pilha">
      <h2 id="titulo-chamada" class="titulo-secao"><Destaque texto={TEXTOS.aulas.inscricoesTitulo} /></h2>
      <p class="texto-suave">{TEXTOS.aulas.horarios}</p>
    </div>
    <div class="botoes">
      <a class="botao" href={linkConsultaTurmas()} target="_blank" rel="noopener">{TEXTOS.botaoTurmas}<span class="so-leitor"> (abre em nova aba)</span></a>
      <a class="botao botao--contorno" href={linkAulaExperimental()} target="_blank" rel="noopener">{TEXTOS.botaoExperimental}<span class="so-leitor"> (abre em nova aba)</span></a>
    </div>
  </div>
  </section>
</BaseLayout>

<script>
  // Filtro por público. Curso sem público informado aparece em todos os filtros.
  const botoes = Array.from(document.querySelectorAll<HTMLButtonElement>('.filtros button[data-publico]'));
  const cursosEls = Array.from(document.querySelectorAll<HTMLElement>('article.curso'));
  const resumo = document.getElementById('resumo')!;
  const vazio = document.getElementById('vazio')!;
  const validos = new Set(botoes.map((b) => b.dataset.publico));

  function aplicar(publico: string, atualizarUrl: boolean) {
    let visiveis = 0;
    for (const el of cursosEls) {
      const lista = (el.dataset.publico ?? '').split(' ');
      const mostra = publico === 'todos' || lista.includes(publico) || lista.includes('indefinido');
      el.hidden = !mostra;
      if (mostra) visiveis++;
    }
    for (const b of botoes) b.setAttribute('aria-pressed', String(b.dataset.publico === publico));
    vazio.hidden = visiveis > 0;
    resumo.textContent = visiveis === 1 ? 'Mostrando 1 curso' : `Mostrando ${visiveis} cursos`;
    if (atualizarUrl) {
      const url = new URL(window.location.href);
      if (publico === 'todos') url.searchParams.delete('publico');
      else url.searchParams.set('publico', publico);
      history.replaceState(null, '', url);
    }
  }

  // Só aceita valores que existem nos botões — nada da URL entra cru na página.
  const inicial = new URLSearchParams(window.location.search).get('publico');
  aplicar(inicial && validos.has(inicial) ? inicial : 'todos', false);
  for (const b of botoes) b.addEventListener('click', () => aplicar(b.dataset.publico!, true));
</script>

<style>
  .topo {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-block: clamp(32px, 5vw, 64px) 32px;
  }

  .trilha {
    font-size: 15px;
    color: var(--texto-suave);
  }

  .intro {
    max-width: 34em;
    font-size: clamp(17px, 1.6vw, 20px);
  }

  .online {
    font-size: 16px;
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 4px;
  }

  .infos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
    margin: 0 0 40px;
  }

  .infos div {
    padding: 18px 22px;
  }

  .infos dt {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .infos dd {
    margin: 6px 0 0;
    font-size: 18px;
  }

  .lista {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: clamp(48px, 7vw, 88px);
  }

  .cab-online {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .curso,
  .curso-online {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 36px;
    padding: clamp(20px, 3vw, 32px);
    scroll-margin-top: 24px;
  }

  .curso[hidden] {
    display: none;
  }

  .quem {
    flex: 0 0 170px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    color: var(--texto);
    font-family: var(--serif);
    font-size: 19px;
    text-decoration: none;
  }

  .quem :global(img) {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 50%;
  }

  .quem:hover span {
    color: var(--oliva);
  }

  .dados {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h2 {
    font-size: clamp(26px, 2.6vw, 32px);
    font-weight: 500;
  }

  .idade {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--oliva);
  }

  .descricao {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 44em;
  }

  .fotos {
    flex: 1 1 100%;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(200px, 1fr);
    gap: 12px;
    margin: 4px 0 0;
    padding: 0 0 8px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .fotos li {
    scroll-snap-align: start;
  }

  .fotos :global(img) {
    display: block;
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 4px;
  }

  .vazio {
    padding: 24px;
    font-family: var(--serif);
    font-size: 20px;
  }

  .legenda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    font-size: 15px;
  }

  .situacao {
    padding: 2px 10px;
    border-radius: var(--raio);
    font-weight: 600;
    font-size: 14px;
  }

  .situacao.vagas {
    background: var(--oliva);
    color: var(--branco);
  }

  .situacao.espera {
    border: 1.5px solid var(--texto-suave);
    color: var(--texto);
  }

  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .chamada {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    padding-block: clamp(56px, 8vw, 104px);
  }

  .pilha {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1 1 420px;
    min-width: 0;
  }

  @media (max-width: 700px) {
    .curso {
      gap: 14px;
      padding: 16px;
    }

    .quem {
      flex: 1 1 100%;
      flex-direction: row;
      justify-content: flex-start;
      gap: 12px;
      text-align: left;
      font-size: 17px;
    }

    .quem :global(img) {
      width: 56px;
      height: 56px;
    }

    .fotos {
      grid-auto-columns: 70%;
    }

    .fotos :global(img) {
      height: 220px;
    }

    .botoes,
    .chamada .botao {
      width: 100%;
    }
  }
</style>
