---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Destaque from '../components/Destaque.astro';
import Preencher from '../components/Preencher.astro';
import CursoCard from '../components/CursoCard.astro';
import ProfessorCirculo from '../components/ProfessorCirculo.astro';
import FaixaObras from '../components/FaixaObras.astro';
import Contato from '../components/Contato.astro';
import { cursos, PUBLICOS, type Publico } from '../content/cursos';
import { professores, professorPorSlug } from '../content/professores';
import { obras } from '../content/obras';
import { TEXTOS } from '../content/textos';
import fotoAbertura from '../assets/atelier/abertura.jpg';
import fotoFundadora from '../assets/atelier/fundadora.jpg';

const fundadora = professores.find((p) => p.fundadora)!;
const donoCanal = professorPorSlug(TEXTOS.youtube.professor);
const canal = donoCanal.links.find((l) => l.url.includes('youtube.com'));
const destaqueObras = obras.slice(0, 4);
const publicos = Object.entries(PUBLICOS) as [Publico, string][];
---

<BaseLayout paginaAtual="inicio">
  <section class="conteiner heroi" aria-labelledby="titulo-heroi">
    <Image
      src={fotoAbertura}
      alt={TEXTOS.abertura.fotoAlt}
      widths={[420, 640, 900, 1200]}
      sizes="(max-width: 900px) 92vw, 560px"
      quality={78}
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="heroi-foto"
    />
    <div class="heroi-texto">
      <p class="sobrancelha">{TEXTOS.abertura.rotulo}</p>
      <h1 id="titulo-heroi"><Destaque texto={TEXTOS.abertura.titulo} /></h1>
      <p class="sub texto-suave">{TEXTOS.abertura.subtitulo}</p>
      <div class="acoes">
        <a class="botao" href="/aulas">Ver as turmas</a>
        <a class="link-seta" href="#contato">Falar com o atelier <span aria-hidden="true">→</span></a>
      </div>
      <nav class="para-quem" aria-label="Aulas por público">
        <span class="texto-suave">{TEXTOS.paraQuem}</span>
        {publicos.map(([valor, rotulo]) => <a class="pilula" href={`/aulas?publico=${valor}`}>{rotulo}</a>)}
      </nav>
    </div>
  </section>

  <section class="faixa-secao" aria-labelledby="titulo-cursos">
    <div class="conteiner secao">
      <div class="cabeca">
        <div class="pilha">
          <h2 id="titulo-cursos" class="titulo-secao"><Destaque texto={TEXTOS.cursos.titulo} /></h2>
          <p class="texto-suave">{TEXTOS.cursos.intro}</p>
        </div>
        <a class="link-seta" href="/aulas">Ver todas as turmas <span aria-hidden="true">→</span></a>
      </div>
      <div class="grade-cursos">
        {cursos.map((curso) => <CursoCard curso={curso} />)}
      </div>
    </div>
  </section>

  <section class="conteiner atelier" aria-labelledby="titulo-atelier">
    <Image
      src={fotoFundadora}
      alt={TEXTOS.atelier.fotoAlt}
      width={360}
      height={360}
      fit="cover"
      position="top"
      quality={74}
      format="webp"
      loading="lazy"
      data-fade=""
      class="foto-redonda"
    />
    <p class="sobrancelha">O atelier</p>
    <h2 id="titulo-atelier" class="titulo-secao"><Destaque texto={TEXTOS.atelier.titulo} /></h2>
    <p class="texto-leitura">{fundadora.bio[0]}</p>
    <p class="texto-suave">{TEXTOS.atelier.sobre ?? <Preencher o="um parágrafo da Ana sobre o atelier" />}</p>
    <a class="botao botao--contorno" href="/o-atelier">Conhecer o atelier</a>
  </section>

  <section class="faixa-secao" aria-labelledby="titulo-professores">
    <div class="conteiner secao">
      <div class="cabeca">
        <h2 id="titulo-professores" class="titulo-secao"><Destaque texto={TEXTOS.professores.titulo} /></h2>
        <a class="link-seta" href="/professores">Conhecer os professores <span aria-hidden="true">→</span></a>
      </div>
      <div class="grade-professores">
        {professores.map((p) => <ProfessorCirculo professor={p} />)}
      </div>
    </div>
  </section>

  {
    canal && (
      <section class="conteiner youtube" aria-labelledby="titulo-youtube">
        <div class="cartao faixa-youtube">
          <div class="pilha">
            <h2 id="titulo-youtube" class="titulo-pequeno">
              <Destaque texto={TEXTOS.youtube.titulo} />
            </h2>
            <p class="texto-suave">{TEXTOS.youtube.texto}</p>
          </div>
          <a class="botao botao--contorno" href={canal.url} target="_blank" rel="noopener">
            Ver o canal d{donoCanal.artigo} {donoCanal.primeiroNome}
          </a>
        </div>
      </section>
    )
  }

  <section class="conteiner mostra" aria-labelledby="titulo-mostra">
    <div class="pilha">
      <p class="sobrancelha">{TEXTOS.mostra.rotulo}</p>
      <h2 id="titulo-mostra" class="titulo-secao"><Destaque texto={TEXTOS.mostra.titulo} /></h2>
      <p class="mostra-texto">{TEXTOS.mostra.texto}</p>
      <p class="texto-suave">{TEXTOS.mostra.detalhe}</p>
    </div>
    <div class="espaco-fotos">
      <Preencher o="fotos da exposição" />
    </div>
  </section>

  <section class="faixa-secao" aria-labelledby="titulo-obras">
    <div class="conteiner secao">
      <div class="cabeca">
        <div class="pilha">
          <h2 id="titulo-obras" class="titulo-secao"><Destaque texto={TEXTOS.obras.titulo} /></h2>
          <p class="texto-suave">{TEXTOS.obras.intro}</p>
        </div>
        <a class="link-seta" href="/obras">Ver todas as obras <span aria-hidden="true">→</span></a>
      </div>
      {destaqueObras.length > 0 && <FaixaObras obras={destaqueObras} />}
    </div>
  </section>

  <Contato />
</BaseLayout>

<style>
  .heroi {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
    padding-block: clamp(32px, 5vw, 72px) clamp(64px, 8vw, 112px);
  }

  .heroi :global(.heroi-foto) {
    width: 100%;
    height: clamp(360px, 44vw, 600px);
    object-fit: cover;
    object-position: 50% 45%;
    border-radius: var(--raio);
  }

  .heroi-texto {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  h1 {
    font-size: clamp(36px, 4.4vw, 60px);
  }

  .sub {
    max-width: 30em;
    font-size: 19px;
    line-height: 1.6;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  .para-quem {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--linha);
    font-size: 15px;
  }

  .secao {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: clamp(64px, 9vw, 120px);
  }

  .cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
  }

  .pilha {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 600px;
  }

  .grade-cursos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 500px), 1fr));
    gap: 24px;
  }

  .atelier {
    max-width: 860px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding-block: clamp(64px, 9vw, 128px);
    text-align: center;
  }

  .atelier :global(.foto-redonda) {
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 50%;
  }

  .grade-professores {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 36px 24px;
  }

  .youtube {
    padding-top: clamp(56px, 7vw, 88px);
  }

  .faixa-youtube {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    padding: clamp(24px, 4vw, 44px);
  }

  .faixa-youtube .pilha {
    flex: 1 1 420px;
    min-width: 0;
  }

  .titulo-pequeno {
    font-size: clamp(26px, 2.6vw, 36px);
  }

  .mostra {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-block: clamp(64px, 9vw, 120px);
  }

  .mostra-texto {
    font-size: 18px;
  }

  .espaco-fotos {
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    border: 1.5px dashed var(--linha-forte);
    border-radius: var(--raio-cartao);
    background: var(--secao);
    text-align: center;
  }

  @media (max-width: 900px) {
    .heroi {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 16px;
    }

    .heroi :global(.heroi-foto) {
      height: 240px;
    }

    .acoes .botao {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .acoes .link-seta {
      width: 100%;
      justify-content: center;
      min-height: 52px;
      border: 1.5px solid var(--oliva);
      border-radius: var(--raio);
      text-decoration: none;
    }

    .para-quem {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .para-quem span {
      grid-column: 1 / -1;
    }

    .para-quem .pilula {
      justify-content: center;
      padding: 0 6px;
      font-size: 14px;
    }

    .grade-cursos {
      gap: 14px;
    }

    .grade-professores {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 12px;
    }

    .faixa-youtube .botao,
    .atelier .botao {
      width: 100%;
    }
  }
</style>
