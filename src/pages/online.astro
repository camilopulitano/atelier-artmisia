---
import { Image } from 'astro:assets';
import grupoZoom from '../assets/online/grupo-zoom.jpg';
import grupoLaranja from '../assets/online/grupo-laranja.jpg';
import grupoVaca from '../assets/online/grupo-vaca.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import FotosCurso from '../components/FotosCurso.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Destaque from '../components/Destaque.astro';
import { cursosOnline, cursosOnlineDe, depoimentosDe, FORMATOS_ONLINE } from '../content/online';
import { professores, retratoDe } from '../content/professores';
import { TEXTOS, semMarcas } from '../content/textos';
import { linkOnline } from '../config/contato';

// Professores que têm aula online, na ordem de professores.ts.
// Relatos de alunas que aparecem logo abaixo do curso correspondente.
const relatosDoCurso: Record<string, 'gravado' | 'ao-vivo'> = {
  'oleo-gravado-ana': 'gravado',
  'oleo-adultos-ana': 'ao-vivo',
};

const comOnline = professores.filter((p) => cursosOnlineDe(p.slug).length > 0);
---

<BaseLayout titulo={semMarcas(TEXTOS.online.titulo)} descricao={TEXTOS.online.intro} paginaAtual="online">
  <section class="conteiner topo" aria-labelledby="titulo-online">
    <nav class="trilha" aria-label="Você está aqui"><a href="/">Início</a> / <span aria-current="page">Aulas online</span></nav>
    <h1 id="titulo-online" class="titulo-pagina"><Destaque texto={TEXTOS.online.titulo} /></h1>
    <p class="intro texto-suave">{TEXTOS.online.intro}</p>
    <p class="texto-suave resumo">{cursosOnline.length} opções com {comOnline.map((p) => p.nome).join(', ').replace(/, (?=[^,]*$)/, ' e ')}. Aulas presenciais em Medianeira: <a href="/aulas">veja aqui</a>.</p>
  </section>

  <section class="faixa-secao" aria-label="Aulas online por professor">
    <div class="conteiner lista">
      {
        comOnline.map((p) => (
          <article class="cartao professor" aria-labelledby={`online-${p.slug}`}>
            <a class="quem" href={`/professores/${p.slug}`}>
              <Image
                src={retratoDe(p)}
                alt={p.retratoAlt}
                widths={[120, 240]}
                sizes="120px"
                quality={74}
                format="webp"
                loading="lazy"
                style={`object-position: ${p.foco}`}
              />
              <span>{p.nome}</span>
            </a>
            <div class="dados">
              <h2 id={`online-${p.slug}`}>Com {p.artigo === 'a' ? 'a' : 'o'} <em>{p.primeiroNome}</em></h2>
              <ul class="cursos" role="list">
                {cursosOnlineDe(p.slug).map((c) => (
                  <li id={c.slug} class:list={['curso', (relatosDoCurso[c.slug] || c.ofertas) && 'curso--largo']}>
                    {c.capa && (
                      <Image
                        src={c.capa}
                        alt={c.capaAlt ?? ''}
                        widths={[320, 480, 640]}
                        sizes="(max-width: 700px) 90vw, 380px"
                        quality={76}
                        format="webp"
                        loading="lazy"
                        data-fade=""
                        class="capa"
                      />
                    )}
                    <span class="formato">{c.rotulo ?? FORMATOS_ONLINE[c.formato]}{c.emBreve && <span class="em-breve">Em breve</span>}</span>
                    <h3>{c.nome}</h3>
                    {c.publico && <p class="publico">{c.publico}</p>}
                    {c.nivel && <p class="nivel">{c.nivel}</p>}
                    {c.ofertas && (
                      <ul class="ofertas" role="list">
                        {c.ofertas.map((o) => (
                          <li><span>{o.titulo}</span><strong>{o.texto}</strong></li>
                        ))}
                      </ul>
                    )}
                    {c.modalidades && <p class="nivel">Modalidades: {c.modalidades.join(', ')}.</p>}
                    {c.fotos && <FotosCurso titulo={`Trabalhos dos alunos de ${p.primeiroNome}`} fotos={c.fotos} />}
                    {c.descricao && c.descricao.split('\n\n').map((par) => <p class="descricao">{par}</p>)}
                    {(c.dia || c.ritmo || c.valor) && (
                      <dl class="detalhes">
                        {c.dia && (<div><dt>Horário</dt><dd>{c.dia}{c.horario ? `, ${c.horario}` : ''}</dd></div>)}
                        {c.ritmo && (<div><dt>Aulas</dt><dd>{c.ritmo}</dd></div>)}
                        {c.valor && (<div><dt>Valor</dt><dd>{c.valor}</dd></div>)}
                      </dl>
                    )}
                    {c.material && <p class="material">{c.material}</p>}
                    <a class="link-seta" href={c.link ?? linkOnline(c, p)} target="_blank" rel="noopener">
                      {c.botao ?? (c.link ? 'Ver o curso' : c.emBreve ? 'Quero ser avisado' : 'Consultar pelo WhatsApp')} <span aria-hidden="true">→</span>
                      <span class="so-leitor"> — {c.nome}{c.publico ? `, ${c.publico}` : ''} (abre em nova aba)</span>
                    </a>
                    {relatosDoCurso[c.slug] && (
                      <Depoimentos
                        id={`dep-${c.slug}`}
                        titulo={relatosDoCurso[c.slug] === 'gravado' ? 'Quem fez o curso' : 'Quem faz as aulas ao vivo'}
                        itens={depoimentosDe(relatosDoCurso[c.slug])}
                      />
                    )}
                    {c.slug === 'oleo-adultos-ana' && (
                      <section class="grupo" aria-labelledby="titulo-grupo">
                        <div class="pilha">
                          <h2 id="titulo-grupo" class="titulo-secao"><Destaque texto={TEXTOS.online.grupoTitulo} /></h2>
                          <p class="texto-suave">{TEXTOS.online.grupoTexto}</p>
                        </div>
                        <div class="fotos-grupo">
                          <Image class="zoom" src={grupoZoom} alt="Aula ao vivo pelo Zoom: três alunas e um aluno sorrindo, cada um mostrando o quadro de um tucano que pintou, e no canto a mesa da professora com a referência, o quadro em andamento e a paleta" widths={[480, 640, 960]} sizes="(max-width: 700px) 90vw, 560px" quality={76} format="webp" loading="lazy" />
                          <Image class="laranja" src={grupoLaranja} alt="Duas fotos de quadros em andamento compartilhadas no grupo: uma laranja e metade de laranja pintadas sobre fundo azul, a tinta cobrindo só parte da tela" widths={[320, 480, 640]} sizes="(max-width: 700px) 90vw, 420px" quality={76} format="webp" loading="lazy" />
                          <Image class="vaca" src={grupoVaca} alt="Foto compartilhada no grupo de um quadro pronto: uma vaca branca e marrom de lenço azul sobre fundo xadrez azul e branco" widths={[320, 480, 640]} sizes="(max-width: 700px) 90vw, 260px" quality={76} format="webp" loading="lazy" />
                        </div>
                      </section>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="conteiner chamada" aria-labelledby="titulo-chamada-online">
    <div class="pilha">
      <h2 id="titulo-chamada-online" class="titulo-secao"><Destaque texto={TEXTOS.online.chamadaTitulo} /></h2>
      <p class="texto-suave">{TEXTOS.online.chamadaTexto}</p>
    </div>
    <a class="botao" href={linkOnline()} target="_blank" rel="noopener">{TEXTOS.online.botao}<span class="so-leitor"> (abre em nova aba)</span></a>
  </section>
</BaseLayout>
<style>
  .topo {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-block: clamp(32px, 5vw, 64px) 40px;
  }

  .trilha {
    font-size: 15px;
    color: var(--texto-suave);
  }

  .intro {
    max-width: 34em;
    font-size: clamp(17px, 1.6vw, 20px);
  }

  .resumo {
    font-size: 16px;
  }

  .lista {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: clamp(48px, 7vw, 88px);
  }

  .professor {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 36px;
    padding: clamp(20px, 3vw, 32px);
  }

  .quem {
    flex: 0 0 170px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    color: var(--texto);
    font-family: var(--serif);
    font-size: 19px;
    text-decoration: none;
  }

  .quem :global(img) {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 50%;
  }

  .quem:hover span {
    color: var(--oliva);
  }

  .dados {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    font-size: clamp(26px, 2.6vw, 32px);
    font-weight: 500;
  }

  .cursos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .curso {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    border-radius: var(--raio);
    background: var(--fundo);
  }

  .curso--largo {
    grid-column: 1 / -1;
  }

  .formato {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .em-breve {
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: var(--raio);
    background: var(--oliva);
    color: var(--branco);
    letter-spacing: 0.08em;
  }

  h3 {
    font-size: 22px;
    font-weight: 500;
  }

  .publico {
    font-size: 16px;
    font-weight: 600;
    color: var(--oliva);
  }

  .nivel {
    font-size: 15px;
    color: var(--texto-suave);
  }

  /* Capa inteira, sem corte: a pintura do mural faz parte da foto. */
  .curso :global(.capa) {
    width: 100%;
    max-height: 340px;
    margin-bottom: 8px;
    object-fit: contain;
    border-radius: 4px;
    background: var(--secao);
  }

  .ofertas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 6px 0;
    padding: 0;
    list-style: none;
  }

  .ofertas li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 16px;
    border-radius: var(--raio);
    background: var(--secao);
  }

  .ofertas span {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .descricao {
    font-size: 16px;
  }

  .material {
    font-size: 14px;
    color: var(--texto-suave);
  }

  .detalhes {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 6px 0 0;
  }

  .detalhes dt {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .detalhes dd {
    margin: 2px 0 0;
    font-size: 16px;
    font-weight: 600;
  }

  .curso .link-seta {
    margin-top: 6px;
    font-size: 15px;
  }

  .grupo {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 24px 48px;
    margin-top: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--secao);
  }

  .fotos-grupo {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 12px;
  }

  .fotos-grupo :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--raio);
  }

  .fotos-grupo :global(.zoom) {
    width: 100%;
    max-width: 560px;
  }

  .fotos-grupo :global(.laranja) {
    width: 100%;
    max-width: 340px;
  }

  .fotos-grupo :global(.vaca) {
    width: 100%;
    max-width: 180px;
  }

  .depoimentos {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: clamp(48px, 7vw, 88px);
  }

  .lista-depoimentos {
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lista-depoimentos::-webkit-scrollbar {
    display: none;
  }

  .controles {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }

  .seta {
    width: 44px;
    height: 44px;
    border: 1px solid var(--texto-suave);
    border-radius: 50%;
    background: transparent;
    color: var(--texto);
    font-size: 20px;
    cursor: pointer;
  }

  .seta:hover {
    background: var(--secao);
  }

  .depoimento {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 20px 32px;
  }

  .fotos-dep {
    flex: 0 1 300px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 100%;
  }

  .depoimento :global(img) {
    width: 300px;
    max-width: 100%;
    height: auto;
    border-radius: var(--raio);
  }

  .depoimento figure {
    flex: 1 1 320px;
    min-width: 0;
    margin: 0;
  }

  .depoimento blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(18px, 1.8vw, 21px);
    line-height: 1.6;
  }

  .depoimento blockquote p + p {
    margin-top: 0.8em;
  }

  .depoimento figcaption {
    margin-top: 14px;
    font-size: 15px;
    font-weight: 600;
    color: var(--oliva);
  }

  .chamada {
    display: flex;
  