---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Destaque from '../../components/Destaque.astro';
import { professores, professorPorSlug, retratoDe } from '../../content/professores';
import { TEXTOS, semMarcas } from '../../content/textos';

const [slugCitacao, indiceCitacao] = TEXTOS.professores.citacao;
const autoraCitacao = professorPorSlug(slugCitacao);
const citacao = autoraCitacao.citacoes[indiceCitacao];
---

<BaseLayout
  titulo="Professores"
  descricao={`${semMarcas(TEXTOS.professores.titulo)}: ${professores.map((p) => p.nome).join(', ')}. ${TEXTOS.professores.intro}`}
  paginaAtual="professores"
>
  <section class="conteiner topo" aria-labelledby="titulo-professores">
    <nav class="trilha" aria-label="Você está aqui"><a href="/">Início</a> / <span aria-current="page">Professores</span></nav>
    <h1 id="titulo-professores" class="titulo-pagina"><Destaque texto={TEXTOS.professores.titulo} /></h1>
    <p class="intro texto-suave">{TEXTOS.professores.intro}</p>

    <div class="grade">
      {
        professores.map((p, i) => (
          <article class="cartao professor">
            <Image
              src={retratoDe(p)}
              alt={p.retratoAlt}
              widths={[160, 320]}
              sizes="160px"
              quality={76}
              format="webp"
              loading={i < 2 ? 'eager' : 'lazy'}
              style={`object-position: ${p.foco}`}
            />
            <div class="texto">
              <h2>{p.nome}</h2>
              <p class="papel">{p.papel}</p>
              <p class="texto-suave">{p.resumo}</p>
              <ul class="tecnicas">
                {p.tecnicas.map((t) => <li>{t}</li>)}
              </ul>
              <a class="link-seta" href={`/professores/${p.slug}`}>
                Conhecer {p.artigo} {p.primeiroNome} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {
    citacao && (
      <section class="faixa-secao" aria-label={`Palavra de ${autoraCitacao.nome}`}>
        <figure class="conteiner citacao">
          <blockquote>“{citacao}”</blockquote>
          <figcaption class="sobrancelha">{autoraCitacao.nome}</figcaption>
        </figure>
      </section>
    )
  }

  <section class="conteiner chamada" aria-labelledby="titulo-chamada">
    <h2 id="titulo-chamada" class="titulo-secao"><Destaque texto={TEXTOS.professores.chamada} /></h2>
    <a class="botao" href="/aulas">Ver as turmas</a>
  </section>
</BaseLayout>

<style>
  .topo {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-block: clamp(32px, 5vw, 64px) clamp(56px, 8vw, 104px);
  }

  .trilha {
    font-size: 15px;
    color: var(--texto-suave);
  }

  .intro {
    max-width: 34em;
    margin-bottom: 20px;
    font-size: clamp(17px, 1.6vw, 20px);
  }

  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 520px), 1fr));
    gap: 24px;
  }

  .professor {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    padding: clamp(20px, 3vw, 28px);
  }

  .professor :global(img) {
    flex: 0 0 160px;
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-radius: 50%;
  }

  .texto {
    flex: 1 1 240px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  h2 {
    font-size: 30px;
    font-weight: 500;
  }

  .papel {
    font-size: 16px;
    font-weight: 600;
  }

  .texto-suave {
    font-size: 16px;
  }

  .tecnicas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tecnicas li {
    padding: 3px 10px;
    border-radius: var(--raio);
    background: var(--secao);
    font-size: 14px;
  }

  .link-seta {
    margin-top: auto;
  }

  .citacao {
    max-width: 940px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding-block: clamp(56px, 8vw, 104px);
    text-align: center;
  }

  blockquote {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(21px, 2.4vw, 30px);
    line-height: 1.45;
  }

  .chamada {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    padding-block: clamp(56px, 8vw, 96px);
  }

  .chamada h2 {
    flex: 1 1 420px;
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 400;
  }

  @media (max-width: 520px) {
    .professor :global(img) {
      flex-basis: 112px;
      width: 112px;
      height: 112px;
    }

    .chamada .botao {
      width: 100%;
    }
  }
</style>
