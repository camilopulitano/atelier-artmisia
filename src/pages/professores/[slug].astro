---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TurmasTabela from '../../components/TurmasTabela.astro';
import { professores, retratoDe, rotuloNoAtelier, trabalhosDe, type Professor } from '../../content/professores';
import { cursosDe, idadeRotulo, turmasDe } from '../../content/cursos';
import { TEXTOS } from '../../content/textos';
import { cursosOnlineDe, FORMATOS_ONLINE } from '../../content/online';
import { linkProfessor } from '../../config/contato';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return professores.map((professor) => ({ params: { slug: professor.slug }, props: { professor } }));
}

interface Props {
  professor: Professor;
}
const { professor: p } = Astro.props;
const retrato = retratoDe(p);
const trabalhos = trabalhosDe(p);
const cursos = cursosDe(p.slug);
const online = cursosOnlineDe(p.slug);
const outros = professores.filter((o) => o.slug !== p.slug);

// "Edison Marsan" → "Edison" + "Marsan" (o sobrenome sai em itálico verde).
const partesNome = p.nome.split(' ');
const ultimoNome = partesNome.pop();
const og = await getImage({ src: retrato, width: 1200, format: 'jpeg', quality: 80 });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.nome,
  jobTitle: p.papel,
  image: new URL(og.src, Astro.site).toString(),
  url: new URL(`/professores/${p.slug}`, Astro.site).toString(),
  knowsAbout: [...p.ensina, ...p.tecnicas],
  worksFor: { '@type': 'EducationalOrganization', name: SITE.nome, url: Astro.site?.toString() },
  ...(p.links.length > 0 && { sameAs: p.links.map((l) => l.url) }),
};
---

<BaseLayout
  titulo={p.nome}
  descricao={`${p.nome}, ${p.papel.charAt(0).toLowerCase()}${p.papel.slice(1)}. ${p.resumo}`}
  imagem={retrato}
  jsonLd={jsonLd}
  paginaAtual="professores"
>
  <article class="conteiner perfil" aria-labelledby="nome">
    <nav class="trilha" aria-label="Você está aqui">
      <a href="/">Início</a> / <a href="/professores">Professores</a> / <span aria-current="page">{p.nome}</span>
    </nav>

    <header class="cabeca">
      <Image
        src={retrato}
        alt={p.retratoAlt}
        widths={[240, 480]}
        sizes="240px"
        quality={80}
        format="webp"
        loading="eager"
        fetchpriority="high"
        style={`object-position: ${p.foco}`}
      />
      <div class="pilha">
        <p class="sobrancelha">{rotuloNoAtelier(p)}</p>
        <h1 id="nome" class="titulo-pagina">{partesNome.join(' ')} <em>{ultimoNome}</em></h1>
        <p class="papel texto-suave">{p.papel}</p>
      </div>
    </header>

    <div class="corpo">
      <div class="principal">
        <dl class="cartao dados">
          <dt>Ensina</dt><dd>{p.ensina.join(' · ')}</dd>
          {p.tecnicas.length > 0 && (<><dt>Técnicas</dt><dd>{p.tecnicas.join(' · ')}</dd></>)}
          {p.desde && (<><dt>Na arte desde</dt><dd>{p.desde}</dd></>)}
        </dl>
        <div class="bio texto-leitura">
          {p.bio.map((paragrafo) => <p>{paragrafo}</p>)}
        </div>
        {
          p.links.length > 0 && (
            <ul class="links">
              {p.links.map((l) => (
                <li><a class="botao botao--contorno" href={l.url} target="_blank" rel="noopener">{l.rotulo}</a></li>
              ))}
            </ul>
          )
        }
      </div>
      {
        p.citacoes.length > 0 && (
          <div class="citacoes">
            {p.citacoes.map((c) => (
              <figure class="citacao">
                <blockquote>“{c}”</blockquote>
                <figcaption class="sobrancelha">{p.nome}</figcaption>
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </article>

  {
    trabalhos.length > 0 && (
      <section class="faixa-secao" aria-labelledby="titulo-trabalhos">
        <div class="conteiner secao">
          <h2 id="titulo-trabalhos" class="titulo-secao">Trabalhos d{p.artigo} <em>{p.primeiroNome}</em></h2>
          <div class="trabalhos">
            {trabalhos.map((t) => (
              <Image
                src={t.src}
                alt={t.alt}
                widths={[320, 480, 720]}
                sizes="(max-width: 700px) 80vw, 360px"
                quality={76}
                format="webp"
                loading="lazy"
                data-fade=""
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section id="turmas" class="conteiner secao" aria-labelledby="titulo-turmas">
    <h2 id="titulo-turmas" class="titulo-secao">{cursos.length > 1 ? 'Cursos' : 'Curso'} d{p.artigo} <em>{p.primeiroNome}</em></h2>
    <ul class="cursos" role="list">
      {
        cursos.map((curso) => (
          <li class="cartao curso">
            <h3><a href={`/aulas#${curso.slug}`}>{curso.nome}</a></h3>
            <p class="idade">{idadeRotulo(curso)}</p>
            <p class="texto-suave">{curso.resumo}</p>
          </li>
        ))
      }
    </ul>
    {
      online.length > 0 && (
        <>
          <h3 class="titulo-online">Online e gravados</h3>
          <ul class="cursos" role="list">
            {online.map((c) => (
              <li class="cartao curso">
                <h3>{c.link ? <a href={c.link} target="_blank" rel="noopener">{c.nome}</a> : <a href="/online">{c.nome}</a>}</h3>
                {c.publico && <p class="idade">{c.publico}</p>}
                <p class="texto-suave">{FORMATOS_ONLINE[c.formato]}{c.emBreve ? ' · em breve' : ''}</p>
              </li>
            ))}
          </ul>
        </>
      )
    }
    {cursos.map((curso) => turmasDe(curso).length > 0 && <TurmasTabela curso={curso} professor={p} comCurso />)}
    <p class="texto-suave">{TEXTOS.aulas.horarios}</p>
    <a class="botao" href={linkProfessor(p)} target="_blank" rel="noopener">{TEXTOS.botaoTurmas}<span class="so-leitor"> d{p.artigo} {p.primeiroNome} (abre em nova aba)</span></a>
  </section>

  <section class="conteiner secao outros-secao" aria-labelledby="titulo-outros">
    <h2 id="titulo-outros" class="titulo-pequeno">Os outros professores</h2>
    <div class="outros">
      {
        outros.map((o) => (
          <a class="cartao outro" href={`/professores/${o.slug}`}>
            <Image src={retratoDe(o)} alt="" widths={[64, 128]} sizes="64px" quality={70} format="webp" loading="lazy" style={`object-position: ${o.foco}`} />
            <span class="outro-texto">
              <span class="outro-nome">{o.nome}</span>
              <span class="texto-suave">{o.ensina.join(' · ')}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .perfil {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: clamp(28px, 4vw, 56px) clamp(48px, 7vw, 88px);
  }

  .trilha {
    font-size: 15px;
    color: var(--texto-suave);
  }

  .cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px 44px;
  }

  .cabeca :global(img) {
    flex: 0 0 240px;
    width: 240px;
    height: 240px;
    object-fit: cover;
    border-radius: 50%;
  }

  .pilha {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    font-size: clamp(40px, 5vw, 68px);
  }

  .papel {
    font-size: 19px;
  }

  .corpo {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    align-items: flex-start;
  }

  .principal {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .dados {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px 24px;
    margin: 0;
    padding: 18px 22px;
  }

  .dados dt {
    color: var(--texto-suave);
  }

  .dados dd {
    margin: 0;
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 40em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .citacoes {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .citacao {
    margin: 0;
    padding: 26px;
    border-radius: var(--raio-cartao);
    background: var(--secao);
  }

  .citacao blockquote {
    margin: 0 0 14px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 21px;
    line-height: 1.5;
  }

  .secao {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-block: clamp(48px, 7vw, 88px);
  }

  .secao > :global(.turmas) {
    width: 100%;
    background: var(--cartao);
  }

  .cursos {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .curso {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 22px;
  }

  .curso h3 {
    font-size: 24px;
    font-weight: 500;
  }

  .curso h3 a {
    color: var(--texto);
    text-decoration: none;
  }

  .curso h3 a:hover {
    color: var(--oliva);
    text-decoration: underline;
  }

  .titulo-online {
    font-size: 24px;
    font-weight: 500;
    margin-top: 8px;
  }

  .idade {
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--oliva);
  }

  .trabalhos {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-end;
  }

  /* Trabalhos sempre inteiros: mesma altura, largura na proporção de cada um. */
  .trabalhos :global(img) {
    height: 320px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    border-radius: 4px;
  }

  .outros-secao {
    border-top: 1px solid var(--linha);
  }

  .titulo-pequeno {
    font-size: 30px;
  }

  .outros {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }

  .outro {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    color: var(--texto);
    text-decoration: none;
  }

  .outro :global(img) {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 50%;
  }

  .outro-texto {
    display: flex;
    flex-direction: column;
    font-size: 14px;
  }

  .outro-nome {
    font-family: var(--serif);
    font-size: 19px;
  }

  .outro:hover .outro-nome {
    color: var(--oliva);
  }

  @media (max-width: 700px) {
    .cabeca :global(img) {
      flex-basis: 160px;
      width: 160px;
      height: 160px;
    }

    .trabalhos :global(img) {
      height: auto;
      width: 100%;
    }

    .secao > .botao {
      width: 100%;
    }
  }
</style>
